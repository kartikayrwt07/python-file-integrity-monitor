# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Pytest and coverage
.pytest_cache/
.coverage
htmlcov/

# Local virtual environments
.venv/
venv/
ENV/
env/

# Generated runtime data and test artifacts (preserve directory skeletons)
data/*.json
reports/*.json
!data/.gitkeep
!reports/.gitkeep
*.tmp

# Root-level temporary lab environments
/lab/
/lab_*/
/demo_*/
/tamper_*/

# Local agent & npm files (keep repository pure Python)
.agents/
.planning/
node_modules/
package.json
package-lock.json

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
